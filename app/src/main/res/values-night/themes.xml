<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Kept only so a system-dark phone still gets light status-bar icons handled by
      MainActivity; the window background deliberately matches the light default (values/colors).
    -->
    <style name="Theme.Tracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
