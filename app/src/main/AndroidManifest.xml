<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The rest timer, which has to reach a phone lying face down on a bench. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A phone without a camera can still log by hand, so this must not gate installation. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".TrackerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The rest notification's own buttons. Not exported: nothing outside the app
             has any business ending someone's rest timer. -->
        <receiver
            android:name=".data.rest.RestActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.yash.tracker.REST_ADD_TIME" />
                <action android:name="com.yash.tracker.REST_SKIP" />
            </intent-filter>
        </receiver>

        <!-- Lets the system camera write a capture into our cache, and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
